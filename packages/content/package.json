{
  "name": "@brain/content",
  "version": "0.0.0",
  "private": true,
  "description": "Concept graph content: domains, nodes, edges and notes, validated at build time.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./load": "./src/load.ts",
    "./validate": "./src/validate.ts"
  },
  "scripts": {
    "build": "node src/cli/compile.ts",
    "dev": "node --watch-path=data --watch-path=src src/cli/compile.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "devDependencies": {
    "@brain/config": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,md,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
