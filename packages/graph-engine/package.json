{
  "name": "@brain/graph-engine",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Framework-free graph engine: graph model, routing, force layout and canvas renderer.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "bench": "node bench/layout.bench.ts"
  },
  "devDependencies": {
    "@brain/config": "workspace:*",
    "@brain/content": "workspace:*",
    "@types/d3-force": "3.0.10",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,md,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "d3-force": "3.0.1"
  }
}
