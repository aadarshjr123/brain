{
  "name": "brain",
  "private": true,
  "description": "A public study map of how frontend development touches the browser.",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run typecheck lint test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@brain/config": "workspace:*",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3"
  },
  "type": "module",
  "lint-staged": {
    "*.{json,md,yml,yaml,css,js,mjs}": "prettier --write"
  }
}
