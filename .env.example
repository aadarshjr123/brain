# Copy to apps/web/.env.local for local overrides. Never commit real values.
# Every variable here is optional: the app builds and runs with none set.

# Canonical URL for metadata. Defaults to the Vercel production domain, then localhost.
NEXT_PUBLIC_SITE_URL=

# Error monitoring (BRAIN-6). Leave empty to disable Sentry entirely.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for source map upload. Set in Vercel, never locally.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
